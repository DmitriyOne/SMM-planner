{
  "git.enabled": false,
  "material-icon-theme.activeIconPack": "nest",
  "material-icon-theme.files.associations": {
    "backend": "nestjs",
    "frontend": "react"
  },
  "explorer.compactFolders": false,
  "cSpell.words": [
    "autoincrement",
    "healthcheck",
    "isready",
    "pgdata"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "always",
    "source.fixAll.eslint": "always"
  },
}
